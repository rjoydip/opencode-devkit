{
  "name": "opencode-devkit",
  "version": "0.0.0",
  "description": "OpenCode Devkit",
  "keywords": [
    "agents",
    "ai-coding",
    "automation",
    "developer-tools",
    "hooks",
    "opencode",
    "tss-elysia"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "commands",
    "prompts",
    "instructions",
    "opencode.json",
    "README.md"
  ],
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.3.6",
    "@tailwindcss/language-server": "^0.14.29",
    "typescript-language-server": "^5.1.3",
    "vscode-langservers-extracted": "^4.10.0",
    "yaml-language-server": "^1.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@typescript/native-preview": "^7.0.0-dev.20260415.1",
    "bumpp": "^11.0.1",
    "tsdown": "^0.21.8",
    "typescript": "^6.0.2"
  }
}